{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Viewer",
  "version": "0.1.0",
  "identifier": "ai.jovis.image-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Image Viewer",
        "width": 1180,
        "height": 760,
        "minWidth": 680,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "homepage": "https://github.com/muthuspark/images-viewer",
    "icon": ["icons/icon.png"],
    "copyright": "Copyright © 2026 Muthukrishnan",
    "license": "MIT",
    "category": "Photography",
    "shortDescription": "Browse local image folders in a minimal desktop gallery.",
    "longDescription": "Image Viewer is a minimal Linux desktop gallery for browsing images directly from local folders."
  }
}
